# Copy this file to the repository root as .env.sag. Never commit the real file.
# The LLM and embedding endpoints must both implement the OpenAI-compatible API.

OPENAI_API_KEY=replace-with-local-or-private-key
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:14b
LLM_STRUCTURED_OUTPUT_MODE=json_object

EMBEDDING_API_KEY=replace-with-local-or-private-key
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3

SAG_STORAGE_MODE=normal
LANGUAGE=zh
LOG_LEVEL=INFO
